+// A one-layer 2D image can be sampled through a 2D-array view. Indirect tables
+// may contain both shapes for the same array-indexed shader; preserving that
+// descriptor avoids replacing a real texture with a null image.
+Decoder::ImageDimension SampledIndirectDimension(const ImageResource& image,
+                                                 const DescriptorValue& descriptor) {
+	auto dimension = DescriptorDimension(descriptor, image.dimension);
+	if (image.resource_class == ImageResourceClass::Sampled &&
+	    image.dimension == Decoder::ImageDimension::Dim2DArray &&
+	    dimension == Decoder::ImageDimension::Dim2D) {
+		dimension = Decoder::ImageDimension::Dim2DArray;
+	}
+	return dimension;
+}
+
