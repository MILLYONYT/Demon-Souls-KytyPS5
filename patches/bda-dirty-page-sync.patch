+void MemoryTracker::CollectCpuDirtyRanges(uint64_t vaddr, uint64_t size,
+                                          std::vector<GuestRange>& ranges) {
+	CheckNotInUploadCallback();
+	ranges.clear();
+	const auto end = GuestRange {vaddr, size}.End();
+	Iterate<true>(vaddr, size, [&](RegionManager* manager, uint64_t offset, uint64_t bytes) {
+		std::scoped_lock lock(manager->lock);
+		manager->ForEachModifiedRange<DirtySource::Cpu, false>(
+		    manager->GetCpuAddr() + offset, bytes, [&](uint64_t dirty, uint64_t length) {
+			    const auto begin = std::max(vaddr, dirty);
+			    const auto finish = std::min(end, dirty + length);
+			    if (begin < finish) ranges.push_back({begin, finish - begin});
+		    });
+	});
+}
