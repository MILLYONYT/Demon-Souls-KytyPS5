diff --git a/src/graphics/host_gpu/renderer/cache/textureCache.cpp b/src/graphics/host_gpu/renderer/cache/textureCache.cpp
index 35e4c7a..0833c57 100644
--- a/src/graphics/host_gpu/renderer/cache/textureCache.cpp
+++ b/src/graphics/host_gpu/renderer/cache/textureCache.cpp
@@ -942,9 +942,25 @@ TextureCache::OverlapResult TextureCache::ResolveOverlap(const ImageInfo& reques
 		const int32_t layer = cached.info.SliceOf(requested, mip);
 		if (layer >= 0) {
 			if (cached.binding.is_target) {
+				const bool native_current = cached.IsGpuModified();
+				const auto prior_usage    = cached.usage;
 				cached.binding.needs_rebind = true;
+				if (native_current && !merged_id) {
+					merged_id = InsertImage(requested);
+					m_slot_images[merged_id].usage = prior_usage;
+					InitializeImage(merged_id);
+				}
 				if (merged_id) {
 					m_slot_images[merged_id].binding.is_target = true;
+					if (native_current) {
+						CopyImageMip(merged_id, cached_id, static_cast<uint32_t>(mip),
+						             static_cast<uint32_t>(layer));
+						static uint32_t mip_preserve_reports = 0;
+						if (mip_preserve_reports++ < 16) {
+							LOGF("Build32 texture target mip preserve: addr=0x%016" PRIx64
+							     " mip=%d layer=%d\n", requested.data.address, mip, layer);
+						}
+					}
 				}
 				FreeImage(cached_id);
 				return {merged_id};
