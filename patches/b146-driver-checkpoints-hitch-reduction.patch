diff --git a/src/local/driver-cache-checkpoint.h b/src/local/driver-cache-checkpoint.h
new file mode 100644
--- /dev/null
+++ b/src/local/driver-cache-checkpoint.h
@@ -0,0 +1,53 @@
+#pragma once
+
+#include <atomic>
+#include <chrono>
+#include <condition_variable>
+#include <cstdint>
+#include <functional>
+#include <mutex>
+#include <thread>
+#include <utility>
+
+// Keep disk writes off the render thread. A failed save leaves the generation
+// dirty; changes made during a save are checkpointed on the following pass.
+class DriverCacheCheckpoint {
+public:
+    explicit DriverCacheCheckpoint(std::function<bool()> save,
+                                   std::chrono::milliseconds interval = std::chrono::seconds(10))
+        : worker([this, save = std::move(save), interval](std::stop_token stop) {
+            uint64_t saved = 0;
+            for (;;) {
+                {
+                    std::unique_lock lock(wait_mutex);
+                    wake.wait_for(lock, stop, interval, [] { return false; });
+                }
+                if (stop.stop_requested()) return;
+                const auto wanted = generation.load(std::memory_order_acquire);
+                if (wanted == saved) continue;
+                try {
+                    if (save()) saved = wanted;
+                } catch (...) {
+                    // Allocation/I/O failures must not terminate a play session.
+                    // The dirty generation is retried on the next interval.
+                }
+            }
+        }) {}
+    ~DriverCacheCheckpoint() { Stop(); }
+    DriverCacheCheckpoint(const DriverCacheCheckpoint&) = delete;
+    DriverCacheCheckpoint& operator=(const DriverCacheCheckpoint&) = delete;
+    void MarkDirty() { generation.fetch_add(1, std::memory_order_release); }
+    void Stop() {
+        if (!worker.joinable()) return;
+        worker.request_stop();
+        wake.notify_all();
+        worker.join();
+    }
+
+private:
+    std::atomic<uint64_t> generation {0};
+    std::mutex wait_mutex;
+    std::condition_variable_any wake;
+    // Last: all state exists before the worker can start, and outlives its join.
+    std::jthread worker;
+};
