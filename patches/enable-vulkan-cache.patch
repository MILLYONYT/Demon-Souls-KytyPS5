diff --git a/src/graphics/host_gpu/vma.cpp b/src/graphics/host_gpu/vma.cpp
index f7b512f..3deb1fa 100644
--- a/src/graphics/host_gpu/vma.cpp
+++ b/src/graphics/host_gpu/vma.cpp
@@ -136,11 +136,29 @@ bool GraphicContext::CreateImage(const vk::ImageCreateInfo& image_info, VulkanIm
 	alloc_info.requiredFlags = VK_MEMORY_PROPERTY_DEVICE_LOCAL_BIT;
 
 	vk::Image::CType native_image = VK_NULL_HANDLE;
-	const auto        result       = static_cast<vk::Result>(
+	auto              result       = static_cast<vk::Result>(
 	    vmaCreateImage(allocator, static_cast<const vk::ImageCreateInfo::NativeType*>(image_info),
 	                   &alloc_info, &native_image, &image.allocation, nullptr));
+	if (result == vk::Result::eErrorOutOfDeviceMemory ||
+	    result == vk::Result::eErrorOutOfHostMemory) {
+		// Prefer the original device-local allocation. If it is exhausted, let VMA
+		// choose another memory type supported by this image before giving up.
+		LOGF("vmaCreateImage: %s; retrying with device-local memory preferred\n",
+		     vk::to_string(result).c_str());
+		native_image        = VK_NULL_HANDLE;
+		image.allocation    = nullptr;
+		alloc_info.requiredFlags  = 0;
+		alloc_info.preferredFlags = VK_MEMORY_PROPERTY_DEVICE_LOCAL_BIT;
+		result = static_cast<vk::Result>(vmaCreateImage(
+		    allocator, static_cast<const vk::ImageCreateInfo::NativeType*>(image_info),
+		    &alloc_info, &native_image, &image.allocation, nullptr));
+	}
 	image.image = native_image;
 	if (result != vk::Result::eSuccess) {
+		LOGF("vmaCreateImage failed: %s, format=%d extent=%ux%ux%u layers=%u levels=%u\n",
+		     vk::to_string(result).c_str(), static_cast<int>(image_info.format),
+		     image_info.extent.width, image_info.extent.height, image_info.extent.depth,
+		     image_info.arrayLayers, image_info.mipLevels);
 		LogMemoryBudget();
 		return false;
 	}
