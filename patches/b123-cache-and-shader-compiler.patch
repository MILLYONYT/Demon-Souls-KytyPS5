diff --git a/src/graphics/shader/recompiler/frontend/ComputeFrontendCache.h b/src/graphics/shader/recompiler/frontend/ComputeFrontendCache.h
new file mode 100644
index 0000000..e8e0a6b
--- /dev/null
+++ b/src/graphics/shader/recompiler/frontend/ComputeFrontendCache.h
@@ -0,0 +1,69 @@
+#pragma once
+#include "graphics/shader/recompiler/frontend/cfg/ShaderCFG.h"
+#include <algorithm>
+#include <deque>
+#include <mutex>
+#include <span>
+#include <string>
+#include <vector>
+namespace Libs::Graphics::ShaderRecompiler::FrontendCache {
+struct CachedComputeFrontend {
+	uint64_t shader_hash = 0;
+	std::vector<uint32_t> code;
+	std::vector<Decoder::Instruction> instructions;
+	CFG::Graph graph;
+	bool dispatcher_fallback = false;
+	std::string dispatcher_reason;
+	size_t estimated_bytes = 0;
+};
+
+inline std::mutex g_compute_frontend_mutex;
+inline std::deque<CachedComputeFrontend> g_compute_frontends;
+constexpr size_t MaxCachedComputeFrontends = 512;
+constexpr size_t MaxCachedComputeFrontendBytes = 256ull * 1024 * 1024;
+inline size_t g_compute_frontend_bytes = 0;
+
+inline bool FindCachedComputeFrontend(std::span<const uint32_t> code, uint64_t hash,
+                               Decoder::Program& decoded, CFG::Graph& graph,
+                               bool& dispatcher_fallback, std::string& dispatcher_reason) {
+	std::lock_guard lock(g_compute_frontend_mutex);
+	for (auto& entry: g_compute_frontends) {
+		if (entry.shader_hash != hash || entry.code.size() != code.size() ||
+		    !std::equal(entry.code.begin(), entry.code.end(), code.begin())) {
+			continue;
+		}
+		decoded.code = code;
+		decoded.instructions = entry.instructions;
+		graph = entry.graph;
+		dispatcher_fallback = entry.dispatcher_fallback;
+		dispatcher_reason = entry.dispatcher_reason;
+		return true;
+	}
+	return false;
+}
+
+inline void RememberComputeFrontend(std::span<const uint32_t> code, uint64_t hash,
+                             const Decoder::Program& decoded, const CFG::Graph& graph,
+                             bool dispatcher_fallback, const std::string& dispatcher_reason) {
+	if (code.size() > 16384) {
+		return;
+	}
+	// Conservatively account for nested CFG vectors as well as instruction storage.
+	const size_t estimated_bytes = code.size() * sizeof(uint32_t) +
+	    decoded.instructions.size() * sizeof(Decoder::Instruction) +
+	    graph.blocks.size() * sizeof(CFG::BasicBlock) * 4;
+	if (estimated_bytes > MaxCachedComputeFrontendBytes) {
+		return;
+	}
+	std::lock_guard lock(g_compute_frontend_mutex);
+	while (!g_compute_frontends.empty() &&
+	       (g_compute_frontends.size() >= MaxCachedComputeFrontends ||
+	        g_compute_frontend_bytes > MaxCachedComputeFrontendBytes - estimated_bytes)) {
+		g_compute_frontend_bytes -= g_compute_frontends.front().estimated_bytes;
+		g_compute_frontends.pop_front();
+	}
+	g_compute_frontends.push_back({hash, {code.begin(), code.end()}, decoded.instructions,
+	                               graph, dispatcher_fallback, dispatcher_reason, estimated_bytes});
+	g_compute_frontend_bytes += estimated_bytes;
+}
+}
