diff --git a/src/graphics/host_gpu/renderer/cache/gpuResourceManager.cpp b/src/graphics/host_gpu/renderer/cache/gpuResourceManager.cpp
index a97e2b3..e350f9e 100644
--- a/src/graphics/host_gpu/renderer/cache/gpuResourceManager.cpp
+++ b/src/graphics/host_gpu/renderer/cache/gpuResourceManager.cpp
@@ -185,7 +185,35 @@ bool GpuResourceManager::PrepareBdaReadRanges(std::span<const GuestRange> ranges
 void GpuResourceManager::PrepareBda() {
 	std::shared_lock lock(m_mapped_ranges_mutex);
 	RefreshBdaRanges();
+#if defined(KYTY_B32_GLOBAL_BDA_EPOCH)
+	const auto cpu_epoch = m_buffer_cache.GlobalCpuModificationEpoch();
+	const auto registered = m_buffer_cache.RegistrationEpoch();
+	if (cpu_epoch != 0 && cpu_epoch == m_bda_last_full_cpu_epoch &&
+	    m_mapping_epoch == m_bda_last_full_mapping_epoch &&
+	    registered == m_bda_last_full_registration_epoch) {
+		// This shortcut applies only to a completed full walk. A read-range-only
+		// preparation cannot mark unrelated BDA buffers as synchronized.
+		static std::atomic<uint64_t> skipped {0};
+		const auto count = skipped.fetch_add(1, std::memory_order_relaxed) + 1;
+		if (count == 1 || count == 4096 || count == 65536)
+			LOGF("Build32 full BDA clean walk skipped: count=%" PRIu64 "\n", count);
+		m_fault_process_pending = true;
+		return;
+	}
+#endif
 	for (auto& request : m_bda_region_requests) m_buffer_cache.SynchronizeRegionRequest(request);
+#if defined(KYTY_B32_GLOBAL_BDA_EPOCH)
+	// CPU writes and buffer registration can overlap a full walk. Cache its
+	// completion only when both generations remained stable across the scan.
+	if (cpu_epoch != 0 && cpu_epoch == m_buffer_cache.GlobalCpuModificationEpoch() &&
+	    registered == m_buffer_cache.RegistrationEpoch()) {
+		m_bda_last_full_cpu_epoch = cpu_epoch;
+		m_bda_last_full_mapping_epoch = m_mapping_epoch;
+		m_bda_last_full_registration_epoch = registered;
+	} else {
+		m_bda_last_full_cpu_epoch = 0;
+	}
+#endif
 	m_fault_process_pending = true;
 }
 
