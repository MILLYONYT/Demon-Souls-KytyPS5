diff --git a/tests/MemoryTrackerTests.cpp b/tests/MemoryTrackerTests.cpp
index 057aaa8..f4b420b 100644
--- a/tests/MemoryTrackerTests.cpp
+++ b/tests/MemoryTrackerTests.cpp
@@ -316,6 +316,40 @@ void TestCpuDirtyUpload() {
   Release(memory);
 }
 
+#if defined(KYTY_B32_GLOBAL_BDA_EPOCH)
+void TestGlobalCpuEpoch() {
+  TrackerHarness harness;
+  auto &tracker = harness.tracker;
+  constexpr auto region_size = Libs::Graphics::TRACKER_REGION_SIZE;
+  const auto page_size = harness.page_manager.GetPageSize();
+  auto *memory = Allocate(harness.page_manager, 2 * region_size / page_size);
+  const auto address = reinterpret_cast<uint64_t>(memory);
+  const auto boundary = (address / region_size + 1) * region_size;
+  const auto first = boundary - page_size;
+
+  const auto initial = tracker.GlobalCpuModificationEpoch();
+  Check(tracker.IsRegionCpuModified(first, page_size) &&
+            tracker.GlobalCpuModificationEpoch() > initial,
+        "new region did not invalidate global CPU epoch");
+  const auto after_first = tracker.GlobalCpuModificationEpoch();
+  Check(tracker.IsRegionCpuModified(boundary, page_size) &&
+            tracker.GlobalCpuModificationEpoch() > after_first,
+        "second tracked region did not invalidate global CPU epoch");
+
+  tracker.ForEachUploadRange(first, page_size, false,
+                             [](uint64_t, uint64_t) noexcept {}, []() noexcept {});
+  const auto clean_epoch = tracker.GlobalCpuModificationEpoch();
+  tracker.MarkRegionAsCpuModified(first, page_size);
+  Check(tracker.GlobalCpuModificationEpoch() > clean_epoch &&
+            tracker.IsRegionCpuModified(first, page_size),
+        "CPU write did not invalidate global CPU epoch");
+
+  tracker.UntrackMemory(first, page_size);
+  tracker.UntrackMemory(boundary, page_size);
+  Release(memory);
+}
+#endif
+
 void TestLocalCpuEpochs() {
   TrackerHarness harness;
   auto &tracker = harness.tracker;
@@ -1082,6 +1116,9 @@ int main(int argc, char **argv) {
   TestQueriesDoNotRequireMappedOwnership();
   TestConcurrentRegionPublication();
   TestCpuDirtyUpload();
+#if defined(KYTY_B32_GLOBAL_BDA_EPOCH)
+  TestGlobalCpuEpoch();
+#endif
   TestLocalCpuEpochs();
   TestFullGpuOwnership();
   TestCpuWriteWindow();
