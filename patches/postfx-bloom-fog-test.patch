+#if defined(KYTY_B32_NO_BLOOM_PYRAMID)
+	// PPSA01342: the captured 0x208934500 extraction is followed by six
+	// 0x208934a00 downsamples and six 0x208935100 upsamples, all writing
+	// R11G11B10F bloom surfaces. Clear each destination so later composite
+	// samples defined black, including after a cached image is reused.
+	static const bool bloom_test_title = [] {
+		std::string title;
+		return Loader::SystemContentParamSfoGetString("TITLE_ID", &title) &&
+		       title == "PPSA01342";
+	}();
+	const uint64_t cs_address = sh_ctx.GetCs().cs_regs.data_addr;
+	const bool bloom_extract = cs_address == 0x0000000208934500ull;
+	const bool bloom_down = cs_address == 0x0000000208934a00ull;
+	const bool bloom_up = cs_address == 0x0000000208935100ull;
+	if (bloom_test_title && (bloom_extract || bloom_down || bloom_up) &&
+	    indirect_args == 0 && mode == 0x41u && !input_info.dispatch_thread_dimensions &&
+	    input_info.threads_num[0] == 8 && input_info.threads_num[1] == 8 &&
+	    input_info.threads_num[2] == 1 && program.info.buffers.empty() &&
+	    program.info.samplers.size() == 1 &&
+	    program.info.images.size() == (bloom_up ? 3u : 2u) &&
+	    resources.images.size() == program.info.images.size()) {
+		const auto index = bloom_up ? 2u : 1u;
+		if (program.info.images[index].written) {
+			const auto descriptor = DecodeNativeDescriptor<ShaderTextureResource>(resources.images[index]);
+			const uint32_t width = static_cast<uint32_t>(descriptor.Width5()) + 1u;
+			const uint32_t height = static_cast<uint32_t>(descriptor.Height5()) + 1u;
+			if (!descriptor.IsNull() && descriptor.Type() == Prospero::ImageType::kColor2D &&
+			    descriptor.Format() == Prospero::BufferFormat::k11_11_10Float &&
+			    width >= 16 && height >= 8 && width <= 2048 && height <= 2048 &&
+			    thread_group_x == (width + 7u) / 8u &&
+			    thread_group_y == (height + 7u) / 8u && thread_group_z == 1) {
+				auto binding = ResolveTexture(program.info.images[index], resources.images[index]);
+				auto& cache = m_context.GetTextureCache();
+				bool cleared = false;
+				if (binding.image_id) {
+					std::scoped_lock lock {cache.m_lock};
+					const auto& image = cache.GetImage(binding.image_id);
+					if (!image.info.IsVolume() && image.info.extent.width == width &&
+					    image.info.extent.height == height && image.info.resources.levels == 1 &&
+					    binding.desc.view_info.base_level == 0 &&
+					    binding.desc.view_info.base_layer == 0 &&
+					    binding.desc.view_info.layer_count == 1) {
+						const vk::ImageSubresourceRange range {vk::ImageAspectFlagBits::eColor,
+						                                       0, 1, 0, 1};
+						cache.ClearImage(buffer, binding.image_id, range, vk::ClearValue {});
+						cleared = true;
+					}
+				}
+				if (cleared) {
+					static std::atomic<uint32_t> reported {0};
+					if (reported.fetch_add(1, std::memory_order_relaxed) < 3) {
+						LOGF("Build32 bloom experiment: bypassed shader=0x%016" PRIx64
+						     " output=%ux%u\n", cs_address, width, height);
+					}
+					ResetBindings();
+					return;
+				}
+			}
+		}
+	}
+#endif
