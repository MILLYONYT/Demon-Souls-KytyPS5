+			               candidate.specialization == specialization;
+			};
+			const Permutation* permutation = nullptr;
+#if defined(KYTY_B32_RECENT_SHADER_PERMUTATION)
+			struct RecentStats {
+				uint64_t recent = 0, fallback = 0, missing = 0;
+			};
+			static thread_local RecentStats stats;
+			if (stats.recent + stats.fallback + stats.missing == 65536) {
+				PipelineCacheLog("Build32 shader permutation reuse: recent={} fallback={} "
+				                 "missing={} (exact specialization and push-data layout)",
+				                 stats.recent, stats.fallback, stats.missing);
+				stats = {};
+			}
+			if (entry->second.last_used && matches(*entry->second.last_used)) {
+				permutation = entry->second.last_used;
