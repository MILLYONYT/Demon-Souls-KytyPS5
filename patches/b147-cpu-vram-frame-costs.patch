diff --git a/src/local/frame-costs.h b/src/local/frame-costs.h
new file mode 100644
--- /dev/null
+++ b/src/local/frame-costs.h
@@ -0,0 +1,36 @@
+#pragma once
+#include <array>
+#include <chrono>
+#include <cstdio>
+#include <cstdlib>
+#include <cstdint>
+namespace FrameCosts {
+enum Kind {Translation, Texture, Pipeline, GpuWait, UploadWait, Idle, Count};
+inline bool Enabled() { static const bool enabled=[] {const char* v=std::getenv("KYTY_FRAME_COSTS"); return v && std::atoi(v)!=0;}(); return enabled; }
+// Exclusive nested accounting: GPU waits inside texture work are charged only
+// to waits. Reports describe this recording thread, not total CPU/GPU utilization.
+struct Ledger {
+    std::array<int64_t,Count> ns {}; int active=-1; int64_t start=0; unsigned frames=0;
+    void Charge(int64_t now) { if(active>=0) ns[active]+=now-start; start=now; }
+    int Enter(int kind,int64_t now) {Charge(now);int prior=active;active=kind;return prior;}
+    void Leave(int prior,int64_t now) {Charge(now);active=prior;}
+};
+inline thread_local Ledger ledger;
+inline int64_t Now() {return std::chrono::duration_cast<std::chrono::nanoseconds>(std::chrono::steady_clock::now().time_since_epoch()).count();}
+class Scope {
+    bool enabled; int prior=-1;
+public:
+    explicit Scope(Kind kind):enabled(Enabled()) {if(enabled) prior=ledger.Enter(kind,Now());}
+    ~Scope() {if(enabled) ledger.Leave(prior,Now());}
+    Scope(const Scope&)=delete; Scope& operator=(const Scope&)=delete;
+};
+inline void Frame() {
+    if(!Enabled()) return;
+    ledger.Charge(Now());
+    if(++ledger.frames<60) return;
+    std::printf("FRAME-COSTS recording-thread avg/60frames ms translation=%.3f texture=%.3f pipeline=%.3f gpu-wait=%.3f upload-wait=%.3f idle=%.3f\n",
+        ledger.ns[Translation]/60e6,ledger.ns[Texture]/60e6,ledger.ns[Pipeline]/60e6,
+        ledger.ns[GpuWait]/60e6,ledger.ns[UploadWait]/60e6,ledger.ns[Idle]/60e6);
+    ledger.ns.fill(0); ledger.frames=0; ledger.start=Now();
+}
+}
