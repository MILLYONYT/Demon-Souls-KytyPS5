new file mode 100644
--- /dev/null
+++ b/src/local/shader-hash-memo.h
@@ -0,0 +1,26 @@
+#pragma once
+#include <array>
+#include <cstddef>
+#include <cstdint>
+namespace ShaderHashMemo {
+// Heap-allocated per thread. Registration generation and size invalidate reuse;
+// changed code at the same registration is periodically rehashed in full.
+class Cache {
+    struct Entry { uint64_t address=0, generation=0, hash=0; size_t bytes=0; unsigned uses=0; bool valid=false, unstable=false; };
+    std::array<Entry,8192> entries {};
+public:
+    template<class Hash> uint64_t Get(uint64_t address, size_t bytes, uint64_t generation, bool verify, Hash hash) {
+        auto& e=entries[((address>>8)^(address>>20)) & (entries.size()-1)];
+        if (!e.valid || e.address!=address || e.bytes!=bytes || e.generation!=generation) {
+            e={address,generation,hash(),bytes,0,true,false};
+            return e.hash;
+        }
+        if (verify || e.unstable || ++e.uses>=64) {
+            const auto fresh=hash();
+            e.unstable |= fresh!=e.hash;
+            e.hash=fresh; e.uses=0;
+        }
+        return e.hash;
+    }
+};
+}
