+++ b/src/local/vram-pressure.h
@@ -0,0 +1,22 @@
+#pragma once
+#include <cstdint>
+#include <algorithm>
+#include <cstdlib>
+namespace VramPressure {
+inline bool Enabled() { static const bool enabled=[] {const char* v=std::getenv("KYTY_VRAM_PRESSURE");return v ? std::atoi(v)!=0 : true;}(); return enabled; }
+// Keep headroom proportional to the current Vulkan budget, including small GPUs.
+template<class Image,class MetadataKind> bool CpuBackedSampled(const Image& image,MetadataKind none) {
+    return image.registered && image.usage.texture && !image.usage.storage &&
+           !image.usage.render_target && !image.usage.depth_target && !image.usage.video_out &&
+           !image.depth_id && !image.info.IsDepth() && !image.info.HasStencil() &&
+           image.info.metadata.kind==none && !image.IsGpuModified() &&
+           !image.IsStencilModified() && !image.IsBufferModified();
+}
+inline uint64_t Target(uint64_t budget) {return budget-std::min<uint64_t>(budget/16,256ull<<20);}
+inline uint64_t PoolLimit(uint64_t usage,uint64_t budget,uint64_t pooled,uint64_t limit) {
+    const auto outside=usage-std::min(usage,pooled);
+    const auto target=Target(budget);
+    return std::min(limit,target>outside ? target-outside : uint64_t{0});
+}
+inline bool Reclaim(uint64_t usage,uint64_t budget) {return budget!=0 && usage>=Target(budget);}
+}
