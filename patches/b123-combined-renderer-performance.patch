+namespace Libs::Graphics::ShaderRecompiler::FrontendCache {
+struct CachedComputeFrontend {
+	uint64_t shader_hash = 0;
+	std::vector<uint32_t> code;
+	std::vector<Decoder::Instruction> instructions;
+	CFG::Graph graph;
+	bool dispatcher_fallback = false;
+	std::string dispatcher_reason;
+	size_t estimated_bytes = 0;
+};
+
+inline std::mutex g_compute_frontend_mutex;
+inline std::deque<CachedComputeFrontend> g_compute_frontends;
+constexpr size_t MaxCachedComputeFrontends = 512;
+constexpr size_t MaxCachedComputeFrontendBytes = 256ull * 1024 * 1024;
+inline size_t g_compute_frontend_bytes = 0;
+
+inline bool FindCachedComputeFrontend(std::span<const uint32_t> code, uint64_t hash,
+                               Decoder::Program& decoded, CFG::Graph& graph,
+                               bool& dispatcher_fallback, std::string& dispatcher_reason) {
+	std::lock_guard lock(g_compute_frontend_mutex);
+	for (auto& entry: g_compute_frontends) {
+		if (entry.shader_hash != hash || entry.code.size() != code.size() ||
+		    !std::equal(entry.code.begin(), entry.code.end(), code.begin())) {
