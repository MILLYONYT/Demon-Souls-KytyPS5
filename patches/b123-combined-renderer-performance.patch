diff --git a/src/graphics/host_gpu/renderer/cache/GuestReadbackPacking.h b/src/graphics/host_gpu/renderer/cache/GuestReadbackPacking.h
new file mode 100644
index 0000000..2621766
--- /dev/null
+++ b/src/graphics/host_gpu/renderer/cache/GuestReadbackPacking.h
@@ -0,0 +1,49 @@
+#pragma once
+
+#include <algorithm>
+#include <cstdint>
+#include <limits>
+#include <vector>
+
+namespace Libs::Graphics::ReadbackPacking {
+struct Envelope { uint64_t source, size, cursor; };
+struct Part { uint64_t address, size, offset; };
+
+// Copy nearby GPU ranges together, but publish only the original dirty bytes.
+class Packing {
+public:
+    std::vector<Envelope> envelopes;
+    std::vector<Part> parts;
+    uint64_t size = 0;
+
+    bool Add(uint64_t source, uint64_t bytes, uint64_t offset,
+             uint64_t address, uint64_t dirty_bytes, uint64_t capacity) {
+        constexpr auto Max = std::numeric_limits<uint64_t>::max();
+        constexpr uint64_t Gap = 64 * 1024;
+        if (!bytes || !dirty_bytes || source > Max - bytes || offset < source ||
+            offset - source > bytes || dirty_bytes > bytes - (offset - source) ||
+            bytes > Max - 63) return false;
+        const auto align = [](uint64_t n) { return (n + 63) & ~uint64_t{63}; };
+        bool merge = false;
+        uint64_t end = source + bytes, extra = align(bytes);
+        if (!envelopes.empty()) {
+            const auto& last = envelopes.back();
+            if (source < last.source) return false;
+            const auto last_end = last.source + last.size;
+            merge = source <= last_end || source - last_end <= Gap;
+            if (merge) {
+                end = std::max(end, last_end);
+                if (end - last.source > Max - 63) return false;
+                extra = align(end - last.source) - align(last.size);
+            }
+        }
+        if (size > capacity || extra > capacity - size) return false;
+        if (merge) envelopes.back().size = end - envelopes.back().source;
+        else envelopes.push_back({source, bytes, size});
+        size += extra;
+        parts.push_back({address, dirty_bytes,
+                         envelopes.back().cursor + offset - envelopes.back().source});
+        return true;
+    }
+};
+} // namespace Libs::Graphics::ReadbackPacking
