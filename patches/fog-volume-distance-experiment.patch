diff --git a/src/graphics/host_gpu/renderer/pipeline/pipelineCache.cpp b/src/graphics/host_gpu/renderer/pipeline/pipelineCache.cpp
index 92fdf97..1e5b74d 100644
--- a/src/graphics/host_gpu/renderer/pipeline/pipelineCache.cpp
+++ b/src/graphics/host_gpu/renderer/pipeline/pipelineCache.cpp
@@ -881,6 +881,33 @@ PipelineCache::Pipeline& PipelineCache::CreateGraphicsPipeline(
 	static_params.stencil_front            = depth.stencil_static_front;
 	static_params.stencil_back             = depth.stencil_static_back;
 	const bool rect_list     = topology == vk::PrimitiveTopology::ePatchList;
+#if defined(KYTY_B32_SHORT_DISTANCE)
+	static const bool distance_test_title = PipelineCacheTitleId() == "PPSA01342";
+	// Cull distant scene fragments through depth bounds. Depth-only shadow maps,
+	// fullscreen rectangles, disabled clipping and guest bounds keep their state.
+	if (distance_test_title && with_depth && color_count != 0 && ps_active &&
+	    depth.depth_test_enable && depth.depth_write_enable && !rect_list &&
+	    !clip_control.clip_disable && static_params.depth_clip_enable &&
+	    !static_params.depth_bounds_test_enable) {
+		const auto op = depth.depth_compare_op;
+		if (op == vk::CompareOp::eGreater || op == vk::CompareOp::eGreaterOrEqual) {
+			static_params.depth_bounds_test_enable = true;
+			static_params.depth_min_bounds = 0.05f;
+			static_params.depth_max_bounds = 1.0f;
+		} else if (op == vk::CompareOp::eLess || op == vk::CompareOp::eLessOrEqual) {
+			static_params.depth_bounds_test_enable = true;
+			static_params.depth_min_bounds = 0.0f;
+			static_params.depth_max_bounds = 0.95f;
+		}
+		if (static_params.depth_bounds_test_enable) {
+			static std::atomic_bool reported {false};
+			if (!reported.exchange(true, std::memory_order_relaxed)) {
+				LOGF("Build32 distance experiment: depth bounds %.2f..%.2f\n",
+				     static_params.depth_min_bounds, static_params.depth_max_bounds);
+			}
+		}
+	}
+#endif
 	static_params.cull_back  = !rect_list && mc.cull_back;
 	static_params.cull_front = !rect_list && mc.cull_front;
 	static_params.face       = mc.face;
diff --git a/src/graphics/host_gpu/renderer/renderCompute.cpp b/src/graphics/host_gpu/renderer/renderCompute.cpp
index 40833cd..f22c5d0 100644
--- a/src/graphics/host_gpu/renderer/renderCompute.cpp
+++ b/src/graphics/host_gpu/renderer/renderCompute.cpp
@@ -24,6 +24,7 @@
 #include "kernel/eventQueue.h"
 #include "kernel/pthread.h"
 #include "libs/errno.h"
+#include "loader/systemContent.h"
 
 #include <algorithm>
 #include <array>
@@ -34,6 +35,7 @@
 #include <limits>
 #include <mutex>
 #include <span>
+#include <string>
 #include <unordered_map>
 #include <vector>
 
@@ -544,6 +546,63 @@ void RenderExecutor::DispatchDirect(uint64_t submit_id, CommandBuffer& buffer,
 		return;
 	}
 
+#if defined(KYTY_B32_NO_VOLUME_FOG)
+	static const bool fog_test_title = [] {
+		std::string title;
+		return Loader::SystemContentParamSfoGetString("TITLE_ID", &title) &&
+		       title == "PPSA01342";
+	}();
+	// Demon's Souls builds an RGBA16F froxel volume at one sixth frame width
+	// and height. The following compute pass samples it. Clear its whole output
+	// to transparent black instead of executing the fog integration kernel.
+	if (fog_test_title && indirect_args == 0 && mode == 0x41u &&
+	    !input_info.dispatch_thread_dimensions && input_info.threads_num[0] == 8 &&
+	    input_info.threads_num[1] == 8 && input_info.threads_num[2] == 1 &&
+	    program.info.buffers.size() == 6 && program.info.images.size() == 11 &&
+	    program.info.samplers.size() == 3 && resources.images.size() == 11 &&
+	    program.info.images[1].written) {
+		const auto descriptor = DecodeNativeDescriptor<ShaderTextureResource>(resources.images[1]);
+		const uint32_t width  = static_cast<uint32_t>(descriptor.Width5()) + 1u;
+		const uint32_t height = static_cast<uint32_t>(descriptor.Height5()) + 1u;
+		const uint32_t depth  = static_cast<uint32_t>(descriptor.Depth()) + 1u;
+		if (!descriptor.IsNull() && descriptor.Type() == Prospero::ImageType::kColor3D &&
+		    descriptor.Format() == Prospero::BufferFormat::k16_16_16_16Float &&
+		    width >= 64 && height >= 32 && depth >= 16 && depth <= 128 &&
+		    thread_group_x == (width + 7u) / 8u &&
+		    thread_group_y == (height + 7u) / 8u && thread_group_z == depth) {
+			auto binding = ResolveTexture(program.info.images[1], resources.images[1]);
+			auto& cache = m_context.GetTextureCache();
+			bool cleared = false;
+			if (binding.image_id) {
+				std::scoped_lock lock {cache.m_lock};
+				const auto& image = cache.GetImage(binding.image_id);
+				if (image.info.IsVolume() && image.info.extent.width == width &&
+				    image.info.extent.height == height && image.info.extent.depth == depth &&
+				    image.info.resources.levels == 1 &&
+				    binding.desc.view_info.base_level == 0 &&
+				    binding.desc.view_info.base_layer == 0 &&
+				    binding.desc.view_info.type == vk::ImageViewType::e3D &&
+				    binding.desc.view_info.layer_count == 1) {
+					const vk::ImageSubresourceRange full_volume {
+					    vk::ImageAspectFlagBits::eColor, 0, 1, 0, depth};
+					cache.ClearImage(buffer, binding.image_id, image.backing.format,
+					                 full_volume, vk::ClearValue {});
+					cleared = true;
+				}
+			}
+			if (cleared) {
+				static std::atomic_bool reported {false};
+				if (!reported.exchange(true, std::memory_order_relaxed)) {
+					LOGF("Build32 fog experiment: cleared RGBA16F volume %ux%ux%u\n",
+					     width, height, depth);
+				}
+				ResetBindings();
+				return;
+			}
+		}
+	}
+#endif
+
 #if defined(KYTY_B32_DISPATCH_STAGE_PROFILE)
 	mark_outer(2);
 #endif
