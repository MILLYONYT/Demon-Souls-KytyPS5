diff --git a/src/local/proven-gpu-worker.h b/src/local/proven-gpu-worker.h
new file mode 100644
index 0000000..7bce813
--- /dev/null
+++ b/src/local/proven-gpu-worker.h
@@ -0,0 +1,92 @@
+#pragma once
+#if defined(_WIN32) && defined(KYTY_B32_FAST_CPU_SETS)
+#ifndef NOMINMAX
+#define NOMINMAX
+#endif
+#include <windows.h>
+#include <algorithm>
+#include <cstddef>
+#include <cstdlib>
+#include <vector>
+#include "common/logging/log.h"
+#endif
+#if defined(_WIN32) && defined(KYTY_B32_FAST_CPU_SETS)
+static void PreferFastCpuSetsForGpuWorker() {
+	const char* setting = std::getenv("KYTY_B32_FAST_CPU_SETS");
+	if (setting != nullptr && setting[0] == '0' && setting[1] == '\0') {
+		LOGF("Build32 GPU worker CPU sets: disabled by environment\n");
+		return;
+	}
+	// The GPU command worker is on the frame's critical path. Raise only this
+	// thread within the normal process priority class; never use real-time mode.
+	const char* priority_setting = std::getenv("KYTY_B32_GPU_PRIORITY");
+	if (priority_setting != nullptr && priority_setting[0] == '0' &&
+	    priority_setting[1] == '\0') {
+		LOGF("Build32 GPU worker priority: disabled by environment\n");
+	} else {
+		const BOOL applied = SetThreadPriority(GetCurrentThread(), THREAD_PRIORITY_HIGHEST);
+		LOGF("Build32 GPU worker priority: requested=highest applied=%u current=%d\n",
+		     static_cast<unsigned>(applied != 0), GetThreadPriority(GetCurrentThread()));
+	}
+	THREAD_POWER_THROTTLING_STATE qos {};
+	qos.Version     = THREAD_POWER_THROTTLING_CURRENT_VERSION;
+	qos.ControlMask = THREAD_POWER_THROTTLING_EXECUTION_SPEED;
+	qos.StateMask   = 0;
+	const BOOL qos_applied = SetThreadInformation(GetCurrentThread(), ThreadPowerThrottling,
+	                                               &qos, sizeof(qos));
+	LOGF("Build32 GPU worker full-speed QoS: applied=%u\n",
+	     static_cast<unsigned>(qos_applied != 0));
+	ULONG bytes = 0;
+	(void)GetSystemCpuSetInformation(nullptr, 0, &bytes, GetCurrentProcess(), 0);
+	if (bytes < sizeof(SYSTEM_CPU_SET_INFORMATION) || bytes > 1024 * 1024) {
+		LOGF("Build32 GPU worker CPU sets: enumeration unavailable\n");
+		return;
+	}
+	std::vector<std::max_align_t> storage(
+	    (bytes + sizeof(std::max_align_t) - 1) / sizeof(std::max_align_t));
+	ULONG returned = 0;
+	if (!GetSystemCpuSetInformation(
+	        reinterpret_cast<PSYSTEM_CPU_SET_INFORMATION>(storage.data()),
+	        static_cast<ULONG>(storage.size() * sizeof(std::max_align_t)), &returned,
+	        GetCurrentProcess(), 0) || returned > storage.size() * sizeof(std::max_align_t)) {
+		LOGF("Build32 GPU worker CPU sets: enumeration failed\n");
+		return;
+	}
+	struct Candidate { ULONG id; BYTE efficiency; bool parked; };
+	std::vector<Candidate> candidates;
+	BYTE slowest = 255, fastest = 0;
+	const auto* data = reinterpret_cast<const unsigned char*>(storage.data());
+	for (size_t offset = 0; offset + sizeof(SYSTEM_CPU_SET_INFORMATION) <= returned;) {
+		const auto* info = reinterpret_cast<const SYSTEM_CPU_SET_INFORMATION*>(data + offset);
+		if (info->Size < sizeof(SYSTEM_CPU_SET_INFORMATION) || info->Size > returned - offset)
+			break;
+		if (info->Type == CpuSetInformation) {
+			const BYTE flags = info->CpuSet.AllFlags;
+			if ((flags & 0x08u) == 0 && ((flags & 0x02u) == 0 || (flags & 0x04u) != 0)) {
+				const auto efficiency = info->CpuSet.EfficiencyClass;
+				candidates.push_back({info->CpuSet.Id, efficiency, (flags & 0x01u) != 0});
+				slowest = std::min(slowest, efficiency);
+				fastest = std::max(fastest, efficiency);
+			}
+		}
+		offset += info->Size;
+	}
+	if (candidates.empty() || fastest == slowest) {
+		LOGF("Build32 GPU worker CPU sets: uniform or unavailable, OS scheduling retained\n");
+		return;
+	}
+	std::vector<ULONG> selected;
+	for (const auto& cpu: candidates) {
+		if (cpu.efficiency == fastest && !cpu.parked) selected.push_back(cpu.id);
+	}
+	if (selected.empty()) {
+		LOGF("Build32 GPU worker CPU sets: fast cores parked, OS scheduling retained\n");
+		return;
+	}
+	const BOOL applied = SetThreadSelectedCpuSets(GetCurrentThread(), selected.data(),
+	                                              static_cast<ULONG>(selected.size()));
+	LOGF("Build32 GPU worker CPU sets: eligible=%zu selected=%zu classes=%u..%u applied=%u\n",
+	     candidates.size(), selected.size(), static_cast<unsigned>(slowest),
+	     static_cast<unsigned>(fastest), static_cast<unsigned>(applied != 0));
+}
+#endif
diff --git a/tests/ComputeFrontendCacheTests.cpp b/tests/ComputeFrontendCacheTests.cpp
new file mode 100644
index 0000000..2190f45
--- /dev/null
+++ b/tests/ComputeFrontendCacheTests.cpp
@@ -0,0 +1,50 @@
+#include "graphics/shader/recompiler/frontend/ComputeFrontendCache.h"
+#include <atomic>
+#include <cstdio>
+#include <cstdlib>
+#include <thread>
+
+using namespace Libs::Graphics::ShaderRecompiler;
+namespace Cache = FrontendCache;
+static void Check(bool condition, const char* message) {
+    if (!condition) { std::fprintf(stderr, "%s\n", message); std::abort(); }
+}
+int main() {
+    std::vector<uint32_t> code {1, 2, 3}, equivalent {1, 2, 3}, collision {1, 2, 4};
+    Decoder::Program input;
+    input.instructions.resize(1);
+    input.instructions[0].pc = 12;
+    CFG::Graph graph;
+    graph.entry_block = 17;
+    Cache::RememberComputeFrontend(code, 42, input, graph, true, "fallback");
+    Decoder::Program output;
+    CFG::Graph result;
+    bool fallback = false;
+    std::string reason;
+    Check(Cache::FindCachedComputeFrontend(equivalent, 42, output, result, fallback, reason), "Equivalent source missed the cache");
+    Check(output.code.data() == equivalent.data(), "Cached decode retains the wrong source lifetime");
+    Check(output.instructions[0].pc == 12 && result.entry_block == 17 && fallback && reason == "fallback", "Cached frontend lost its graph or fallback state");
+    Check(!Cache::FindCachedComputeFrontend(collision, 42, output, result, fallback, reason), "Hash collision reused a different shader");
+    Check(!Cache::FindCachedComputeFrontend(code, 43, output, result, fallback, reason), "Different shader identity reused the cache");
+    output.instructions[0].pc = 99;
+    result.entry_block = 99;
+    Check(Cache::FindCachedComputeFrontend(code, 42, output, result, fallback, reason) && output.instructions[0].pc == 12 && result.entry_block == 17, "Mutating a returned graph changed the stored frontend");
+    std::atomic<bool> valid {true};
+    std::vector<std::thread> threads;
+    for (int i = 0; i < 4; ++i) threads.emplace_back([&] {
+        for (int n = 0; n < 100; ++n) {
+            Decoder::Program copy; CFG::Graph cfg; bool dispatch = false; std::string why;
+            if (!Cache::FindCachedComputeFrontend(code, 42, copy, cfg, dispatch, why) || copy.instructions[0].pc != 12) valid.store(false);
+        }
+    });
+    for (auto& thread : threads) thread.join();
+    Check(valid.load(), "Parallel shader warmup reads changed frontend data");
+    for (size_t i = 0; i < Cache::MaxCachedComputeFrontends; ++i) {
+        std::vector<uint32_t> other {static_cast<uint32_t>(i + 100)};
+        Cache::RememberComputeFrontend(other, i + 100, input, graph, false, "");
+    }
+    Check(Cache::g_compute_frontends.size() == Cache::MaxCachedComputeFrontends, "Frontend cache exceeded its entry cap");
+    Check(Cache::g_compute_frontend_bytes <= Cache::MaxCachedComputeFrontendBytes, "Frontend cache exceeded its estimated byte cap");
+    Check(!Cache::FindCachedComputeFrontend(code, 42, output, result, fallback, reason), "Old frontend was not evicted at the cache limit");
+    std::puts("Frontend cache identity, lifetime, graph isolation, concurrency and eviction passed");
+}
