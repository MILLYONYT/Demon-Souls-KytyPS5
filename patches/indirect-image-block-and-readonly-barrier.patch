+bool ReadLinearTestMemoryBlock(void *userdata, uint64_t address, uint32_t *values,
+                               uint32_t count, bool clean) {
+  auto *memory = static_cast<LinearTestMemory *>(userdata);
+  if (memory == nullptr || !clean || memory->reject_blocks || count != 8u ||
+      values == nullptr || address < memory->base || (address & 3u) != 0u ||
+      address - memory->base > memory->words.size() * sizeof(uint32_t) - 32u ||
+      (memory->fail_address >= address && memory->fail_address - address < 32u))
+    return false;
+  std::copy_n(memory->words.begin() + (address - memory->base) / 4u, count, values);
+  ++memory->block_reads;
+  return true;
+}
