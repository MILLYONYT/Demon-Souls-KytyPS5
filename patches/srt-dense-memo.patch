+// ResourcePlan owns stable instruction objects. Slots assigned while cloning the
+// plan let the hot evaluator bypass pointer hashing for its own instructions.
+// Reuse arenas by nesting depth so the clean and active evaluators remain isolated.
+struct DenseMemoEntry {
+	const Inst* owner = nullptr;
+	uint64_t value = 0;
+	uint32_t generation = 0;
+};
+
+struct DenseMemoArena {
+	std::vector<DenseMemoEntry> entries;
+	uint32_t generation = 0;
+	void Advance() {
+		if (generation == UINT32_MAX) {
+			for (auto& entry : entries) entry.generation = 0;
+			generation = 0;
+		}
+		++generation;
+	}
+};
+
+struct DenseMemoStack {
+	std::vector<std::unique_ptr<DenseMemoArena>> arenas;
+	size_t depth = 0;
+	DenseMemoArena& Acquire() {
+		if (depth == arenas.size()) arenas.push_back(std::make_unique<DenseMemoArena>());
+		auto& arena = *arenas[depth++];
+		arena.Advance();
+		return arena;
+	}
+	void Release() { --depth; }
+};
+
+DenseMemoStack& MemoStack() {
+	thread_local DenseMemoStack stack;
+	return stack;
+}
+
+class DenseMemoLease {
+public:
+	DenseMemoLease() : m_arena(MemoStack().Acquire()) {}
+	~DenseMemoLease() { MemoStack().Release(); }
+	DenseMemoLease(const DenseMemoLease&) = delete;
+	DenseMemoLease& operator=(const DenseMemoLease&) = delete;
+	DenseMemoArena& Arena() const { return m_arena; }
+private:
+	DenseMemoArena& m_arena;
+};
